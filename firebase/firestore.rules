rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null;}
    function isAdminDoc(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';}
    function admin(){return signedIn() && (request.auth.token.admin == true || isAdminDoc());}
    function me(uid){return signedIn() && request.auth.uid == uid;}
    match /users/{uid}{
      allow create: if me(uid) && request.resource.data.role in ['customer','seller'];
      allow read: if me(uid) || admin();
      allow update: if admin() || (me(uid) && request.resource.data.role == resource.data.role);
      allow delete: if admin();
    }
    match /sellerProfiles/{uid}{allow read: if signedIn(); allow create,update: if me(uid) || admin(); allow delete: if admin();}
    match /businesses/{id}{
      allow read: if resource.data.status == 'published' || admin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update,delete: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
    match /products/{id}{
      allow read: if resource.data.status == 'published' || admin() || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update,delete: if admin() || (signedIn() && resource.data.sellerId == request.auth.uid);
    }
    match /orders/{id}{
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if admin() || (signedIn() && (resource.data.customerId == request.auth.uid || resource.data.sellerIds.hasAny([request.auth.uid])));
      allow update: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow delete: if false;
    }
    match /stories/{id}{
      allow read: if resource.data.status == 'published' || admin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update,delete: if admin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
    match /reviews/{id}{
      allow read: if resource.data.status == 'published' || admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update,delete: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
    }
    match /posts/{id}{
      allow read: if resource.data.status == 'published' || admin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update,delete: if admin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
    match /posts/{id}/likes/{uid}{allow read: if true; allow create,delete: if signedIn() && request.auth.uid == uid;}
    match /posts/{id}/comments/{cid}{
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow delete: if admin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
    match /conversations/{cid}{
      allow read: if signedIn() && (request.auth.uid in resource.data.participantIds || admin());
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds && request.resource.data.participantIds.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds && request.resource.data.participantIds == resource.data.participantIds;
    }
    match /conversations/{cid}/messages/{mid}{
      allow read: if signedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds || admin());
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000 && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds;
      allow update: if signedIn() && (
        (resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','editedAt'])
          && resource.data.get('type','') != 'offer'
          && resource.data.get('deleted', false) == false
          && request.time < resource.data.createdAt + duration.value(15, 'm')
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000)
        || (resource.data.senderId == request.auth.uid
          && resource.data.get('type','') != 'offer'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','deleted','deletedAt'])
          && request.resource.data.deleted == true)
        || (request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
          && request.auth.uid in request.resource.data.hiddenFor
          && request.resource.data.hiddenFor.hasAll(resource.data.get('hiddenFor', []))));
    }
    match /offers/{oid}{
      allow read: if signedIn() && (request.auth.uid in resource.data.participantIds || admin());
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.buyerId in request.resource.data.participantIds
        && request.resource.data.qty is int && request.resource.data.qty > 0
        && request.resource.data.unitPrice is number && request.resource.data.unitPrice >= 0
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sellerId == request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.sellerId == request.auth.uid && resource.data.status == 'open' && request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (resource.data.buyerId == request.auth.uid && resource.data.status == 'open' && request.resource.data.status == 'used' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt'])));
    }
    match /productLikes/{lid}{
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && lid == request.auth.uid + '_' + request.resource.data.productId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /liveSessions/{id}{allow read: if resource.data.status == 'live' || admin() || (signedIn() && resource.data.hostId == request.auth.uid);allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;allow update,delete: if admin() || (signedIn() && resource.data.hostId == request.auth.uid);}
    match /liveSessions/{id}/peers/{pid}{
      allow read: if signedIn() && (request.auth.uid == pid || get(/databases/$(database)/documents/liveSessions/$(id)).data.hostId == request.auth.uid);
      allow create: if signedIn() && request.auth.uid == pid;
      allow update, delete: if signedIn() && (request.auth.uid == pid || get(/databases/$(database)/documents/liveSessions/$(id)).data.hostId == request.auth.uid);
    }
    match /liveSessions/{id}/chat/{mid}{allow read,create: if signedIn();}
    match /notifications/{id}{allow read: if signedIn() && resource.data.userId == request.auth.uid || admin();allow create: if admin();}
  }
}
