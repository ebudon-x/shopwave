rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){return request.auth != null;}
    function owner(uid){return signedIn() && request.auth.uid == uid;}
    match /products/{uid}/{fileName}{allow read: if true;allow write: if owner(uid) && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');}
    match /stories/{uid}/{fileName}{allow read: if true;allow write: if owner(uid) && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');}
    match /businesses/{uid}/{fileName}{allow read: if true;allow write: if owner(uid) && request.resource.size < 10 * 1024 * 1024;}
    match /posts/{uid}/{fileName}{allow read: if true;allow write: if owner(uid) && request.resource.size < 10 * 1024 * 1024;}
  }
}
